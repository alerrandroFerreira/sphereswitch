{
  "name": "sphereswitch-bridge",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Puente WebSocket local para la sincronización en vivo entre SphereSwitch y el plugin de Figma.",
  "license": "MIT",
  "author": "Alerrandro Heron Ferreira",
  "keywords": [
    "sphereswitch",
    "figma",
    "websocket",
    "bridge"
  ],
  "bin": {
    "sphereswitch-bridge": "./dist/cli.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo .tsbuild *.tsbuildinfo"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
