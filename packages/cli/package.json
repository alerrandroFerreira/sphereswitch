{
  "name": "sphereswitch",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "CLI de SphereSwitch: copia la plantilla de sphereswitch.config al proyecto.",
  "license": "MIT",
  "author": "Alerrandro Heron Ferreira",
  "keywords": [
    "sphereswitch",
    "cli",
    "theming",
    "scaffold"
  ],
  "bin": {
    "sphereswitch": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo .tsbuild *.tsbuildinfo"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
