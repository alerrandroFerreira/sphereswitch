{
  "name": "sphereswitch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Motor de theming en tiempo real (fuente, paleta, layout), distribuido como paquetes npm.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "coverage": "pnpm -r --if-present test -- --coverage",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "tsc -b",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "knip": "^6.34.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.19.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
